# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database
POSTGRES_DB=todobot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token-here

# API URL (for bot to connect to Django)
DJANGO_API_URL=http://web:8000/api

# Shared secret between bot and Django API (leave empty to disable auth in dev)
INTERNAL_API_KEY=change-me-in-production
